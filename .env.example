# Docker Compose infrastructure settings.
# Copy to .env at the repo root: cp .env.example .env
# These only configure the local containers. App config lives in apps/*/.env*

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=podcast

# ⚠️ NOT 5432. This dev machine runs native PostgreSQL 16 AND 18 Windows services
# that already own 5432 and 5433. Publishing the container on 5432 appears to work
# but connections silently reach the NATIVE server instead, failing with
# "password authentication failed for user postgres". Verified 2026-08-08.
POSTGRES_PORT=54320

REDIS_PORT=6379

# Local dev only. Generate a real one for any deployed environment.
MEILI_MASTER_KEY=masterKeyForLocalDevOnly
MEILI_PORT=7700
