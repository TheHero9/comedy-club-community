# ---- apps/web ----
# Copy to .env.local and fill in. Only NEXT_PUBLIC_* values reach the browser.

# Base URL of the Django-Ninja API. No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local-only development identity, unset by default and unset in every deployed
# environment. When set, the browser sends `Authorization: Bearer dev:<value>`,
# which the API's DevAuth backend accepts. It exists so the signed-in half of
# the UI (rating sheet, watch log, favourites, profile) can be built and tested
# before Clerk keys arrive. `prod.py` refuses to boot with that backend.
# See apps/web/lib/auth.ts.
# NEXT_PUBLIC_DEV_USER=demo

# ---- Wave 8 (Clerk auth) - not used yet ----
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# ---- Later waves (analytics, errors) - not used yet ----
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_SENTRY_DSN=
