# Copy to apps/api/.env

# ---- Django ----
DJANGO_SECRET_KEY=dev-insecure-change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.dev

# ---- Data stores (one URL each: local Docker now, managed host later) ----
DATABASE_URL=postgres://postgres:postgres@localhost:54320/podcast
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1

# ---- Frontend ----
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ---- Search (wave 12) ----
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=masterKeyForLocalDevOnly

# ---- YouTube (wave 5). yt-dlp backfill needs NO key. ----
YOUTUBE_API_KEY=

# ---- Clerk (wave 8) ----
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_WEBHOOK_SECRET=

# ---- Cloudflare R2 (wave 10). Local dev writes to MEDIA_ROOT instead. ----
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---- Observability ----
SENTRY_DSN=
